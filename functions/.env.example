# Copy to functions/.env for the emulator. In production use:
#   firebase functions:secrets:set GEMINI_API_KEY
#   firebase functions:secrets:set ANTHROPIC_API_KEY
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Optional overrides
GEMINI_MODELS=gemini-2.5-flash,gemini-flash-latest,gemini-3.5-flash
ANTHROPIC_MODEL=claude-opus-5
