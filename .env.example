# Copy to apps/web/.env.local and fill from Firebase console > Project settings > Web app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=valeur-credit
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Set to "true" to point the app at the local emulator suite
VITE_USE_EMULATORS=true
